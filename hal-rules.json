{
  "extends": ["./registry/recommended.json"],
  "rulesDir": ["registry/rules"],
  "rules": {
    "workflow/before-finish": [
      "on",
      {
        "checks": [
          "pnpm build",
          "pnpm tsc",
          "pnpm lint",
          "pnpm format:check",
          "pnpm test",
          "./scripts/verify-loading.sh",
          "./scripts/verify-subagent.sh"
        ]
      }
    ],
    "workflow/out-of-scope-findings": [
      "off",
      {
        "findingsFile": "docs/findings.md"
      }
    ],
    "documentation/architecture-decisions": [
      "off",
      {
        "adrDir": "docs/adr/"
      }
    ]
  }
}
