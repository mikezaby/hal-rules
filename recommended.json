{
  "rulesDir": ["rules"],
  "rules": {
    "workflow/scope-discipline": "on",
    "workflow/incremental-delivery": "on",
    "git/never-push": "on",
    "documentation/docs-in-the-same-commit": "on",
    "documentation/no-scratch-files": "on",
    "testing/test-organization": "on",
    "code-style/comments": "on",
    "code-style/no-nested-ternaries": "on",
    "architecture/reuse-existing-components": "on",
    "architecture/mark-deliberate-simplifications": [
      "on",
      { "marker": "ponytail:" }
    ]
  }
}
