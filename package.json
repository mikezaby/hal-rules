{
  "name": "hal-rules",
  "version": "0.7.0",
  "description": "Compose Claude Code rules from shareable packs, eslint-style: extend a base config, turn rules off, tune them (pre-1.0, format may change)",
  "keywords": [
    "claude",
    "claude-code",
    "rules",
    "config",
    "eslint",
    "ai",
    "agent",
    "mcp",
    "monorepo"
  ],
  "homepage": "https://github.com/mikezaby/hal-rules#readme",
  "bugs": {
    "url": "https://github.com/mikezaby/hal-rules/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikezaby/hal-rules.git"
  },
  "author": "Michalis Zabaras",
  "license": "ISC",
  "type": "module",
  "bin": {
    "hal": "./dist/cli.mjs",
    "hal-rules": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./recommended.json": "./registry/recommended.json",
    "./rules/*": "./registry/rules/*",
    "./registry/*": "./registry/*"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "registry"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "clean:dist": "rm -rf ./dist",
    "dev": "tsdown --watch --no-clean",
    "lint": "eslint src test",
    "test": "node --test test/*.test.ts",
    "tsc": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "release": "pnpm run build && pnpm publish --access public",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "^24.0.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "packageManager": "pnpm@11.23.0"
}
